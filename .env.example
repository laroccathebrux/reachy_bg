# Copy to .env and adjust. Every value has a working local default; secrets are the exception.

# ---- Game ----
GAME_ID=eldritch-horror

# ---- Languages (bilingual table) ----
SPOKEN_LANGUAGES=pt-BR,en-US     # languages the robot understands and speaks
DEFAULT_LANGUAGE=pt-BR           # used until someone speaks, and as voice fallback
LANGUAGE_SWITCH_THRESHOLD=1      # utterances in another language before the robot switches

# ---- Qdrant (Docker container reachy-books-qdrant) ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ---- Ollama ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:35b-mlx     # reasoning; see docs/MODEL_SIZING.md
EMBED_MODEL=bge-m3               # embeddings for every Qdrant collection

# ---- Reachy Mini (daemon started with `reachy-mini-daemon`) ----
REACHY_HOST=127.0.0.1
REACHY_PORT=8000
REACHY_CONNECTION_MODE=auto      # auto | localhost_only | network
REACHY_MEDIA_BACKEND=default     # default | local | webrtc | no_media

# ---- Audio input (the robot mic is broken: always a Mac input device) ----
AUDIO_INPUT_DEVICE=              # empty = system default input; or a device name substring
AUDIO_SAMPLE_RATE=16000

# ---- Speech ----
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_LANGUAGE=auto            # per-utterance language identification; or pt / en to pin
DIARIZER_URL=ws://127.0.0.1:8765 # live diarizer sidecar
HF_TOKEN=                        # needed once to download the gated pyannote models

# ---- Voice output: one NATIVE voice per language ----
TTS_PROVIDER=elevenlabs          # elevenlabs | local
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID_PT_BR=       # a Brazilian Portuguese native voice
ELEVENLABS_VOICE_ID_EN_US=       # an American English native voice
LOCAL_TTS_VOICE_PT_BR=pt_BR-faber-medium   # Piper-style voice names for TTS_PROVIDER=local
LOCAL_TTS_VOICE_EN_US=en_US-lessac-medium

# ---- Vision ----
VISION_URL=http://127.0.0.1:8090
VISION_MODEL=yolov8s-worldv2.pt
VISION_MIN_CONFIDENCE=0.35

# ---- Directories / logging ----
DATA_DIR=./data
LOG_LEVEL=INFO
LOG_FILE=./app.log
ENVIRONMENT=development
DEBUG=false
