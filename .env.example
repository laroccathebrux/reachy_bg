# Copy to .env and adjust. Every value has a working local default; secrets are the exception.

# ---- Game ----
GAME_ID=eldritch-horror

# ---- Languages (bilingual table) ----
SPOKEN_LANGUAGES=pt-BR,en-US     # languages the robot understands and speaks
DEFAULT_LANGUAGE=pt-BR           # used until someone speaks, and as voice fallback
LANGUAGE_SWITCH_THRESHOLD=1      # utterances in another language before the robot switches

# ---- Qdrant (Docker container reachy-books-qdrant) ----
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# ---- Ollama ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6:35b-mlx     # reasoning; see docs/MODEL_SIZING.md
OLLAMA_KEEP_ALIVE=30m            # keep the model loaded between questions (a reload costs ~30 s)
EMBED_MODEL=bge-m3               # embeddings for every Qdrant collection

# ---- Reachy Mini (daemon started with `reachy-mini-daemon`) ----
REACHY_HOST=127.0.0.1
REACHY_PORT=8000
REACHY_CONNECTION_MODE=auto      # auto | localhost_only | network
REACHY_MEDIA_BACKEND=default     # default | local | webrtc | no_media

# ---- Audio input (the robot mic is broken: always a Mac input device) ----
AUDIO_INPUT_DEVICE=              # empty = system default input; or a device name substring / index
AUDIO_SAMPLE_RATE=16000
# Voice activity detection (energy based; see src/speech/microphone.py)
VAD_FRAME_MS=30
VAD_SILENCE_MS=600               # silence that ends an utterance
VAD_MIN_SPEECH_MS=300            # shorter bursts (clicks, coughs) are dropped
VAD_PRE_ROLL_MS=300              # audio kept from before the detected start
VAD_MAX_UTTERANCE_S=20
VAD_THRESHOLD_DBFS=-50           # absolute floor for "speech"
VAD_NOISE_MARGIN_DB=8            # speech must exceed the adaptive noise floor by this much
BARGE_IN_MARGIN_DB=4             # extra margin while the robot speaks; its own words are filtered by text
BARGE_IN_MIN_MS=600              # voice length that triggers an interruption check
SAVE_CAPTURES=true               # keep every utterance as data/captures/audio/*.wav

# ---- Speech ----
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_LANGUAGE=auto            # per-utterance language identification; or pt / en to pin
WHISPER_PROMPT=Eldritch Horror, Ancient One, Doom, Omen, Mythos, Clue, Gate, Action Phase, Encounter Phase.
DIARIZER_URL=ws://127.0.0.1:8765 # live diarizer sidecar (tools/live-diarizer)
HF_TOKEN=                        # gated pyannote models; empty = the cached `hf auth login` token
SPEAKER_EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
SPEAKER_MATCH_THRESHOLD=0.30     # cosine similarity that names a voice (same person 0.36-0.59 measured)
ROBOT_NAME=Reachy
ROBOT_NAME_ALIASES=reachy,reachie,reachi,reaxi,reed,ride,riche,richie,richy,rich,ritch,ritchie,ritchy,reach,richi,ricci,rishi,ricky,rachi   # what Whisper hears
FOLLOW_UP_WINDOW_S=8             # a question this soon after the robot spoke is a follow-up to it
ANSWER_GAME_QUESTIONS=true       # answer rules questions asked to the table without the robot's name

# ---- Voice output: one NATIVE voice per language ----
TTS_PROVIDER=elevenlabs          # elevenlabs | local
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID_PT_BR=0t7A9YvHlaUjp3Mon3X1   # Brazilian Portuguese native voice
ELEVENLABS_VOICE_ID_EN_US=vChnJZ1Cu89g2XXumPfT   # American English native voice
ELEVEN_AGENT_VOICE_ID_PT_BR=OB6x7EbXYlhG4DDTB1XU # agent voice for pt-BR (Michelle; Mariana has live moderation, agents refuse it)
# ---- Conversation agent (ElevenLabs Agents: ASR + LLM + TTS + turn-taking in the cloud) ----
ELEVEN_AGENT_ID=                 # empty = created once and remembered in data/eleven_agent.json
ELEVEN_AGENT_NAME=Reachy Eldritch Horror
ELEVEN_AGENT_LLM=gpt-4.1-mini    # empty = platform default (gemini-2.5-flash)
ELEVEN_TURN_TIMEOUT_S=300        # the default (~7 s) nags "are you there?" during a game
ELEVEN_MAX_DURATION_S=7200
AUDIO_OUTPUT_DEVICE=Reachy Mini Audio   # the robot speaker as a USB device on the Mac
HEAD_SWAY=true                   # move the head with the voice (the daemon wobbler cannot see USB audio)
LOCAL_TTS_VOICE_PT_BR=pt_BR-faber-medium   # Piper-style voice names for TTS_PROVIDER=local
LOCAL_TTS_VOICE_EN_US=en_US-lessac-medium

# ---- Vision ----
VISION_URL=http://127.0.0.1:8090
VISION_MODEL=yolov8s-worldv2.pt
VISION_MIN_CONFIDENCE=0.35

# ---- Directories / logging ----
DATA_DIR=./data
LOG_LEVEL=INFO
LOG_FILE=./app.log
ENVIRONMENT=development
DEBUG=false
